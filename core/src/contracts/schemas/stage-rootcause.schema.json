{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-rootcause.schema.json",
  "title": "Provider stage output: rootcause",
  "type": "object",
  "required": ["summary", "locations", "fix_direction", "confidence"],
  "properties": {
    "summary": { "type": "string" },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "start_line", "end_line", "reason"],
        "properties": {
          "file": { "type": "string" },
          "start_line": { "type": "integer" },
          "end_line": { "type": "integer" },
          "reason": { "type": "string" }
        }
      }
    },
    "fix_direction": { "type": "string" },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
  }
}
