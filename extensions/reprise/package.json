{
  "name": "reprise",
  "displayName": "Reprise",
  "description": "Bug replication and fix pipeline for mobile and desktop apps.",
  "version": "0.1.0",
  "publisher": "reprise-ide",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "browser": "./dist/extension.js",
  "extensionKind": [
    "web"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reprise",
          "title": "Reprise",
          "icon": "media/icons/reprise-activitybar.svg"
        }
      ]
    },
    "views": {
      "reprise": [
        {
          "id": "reprise.bugReports",
          "name": "Bug Reports",
          "type": "tree",
          "when": "true"
        },
        {
          "id": "reprise.runs",
          "name": "Runs",
          "type": "tree",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "reprise.signIn",
        "title": "Reprise: Sign In to GitHub"
      },
      {
        "command": "reprise.signOut",
        "title": "Reprise: Sign Out"
      },
      {
        "command": "reprise.linkRepository",
        "title": "Reprise: Link Repository"
      },
      {
        "command": "reprise.connectRunner",
        "title": "Reprise: Connect Runner"
      },
      {
        "command": "reprise.disconnectRunner",
        "title": "Reprise: Disconnect Runner"
      },
      {
        "command": "reprise.acknowledgeBugReport",
        "title": "Reprise: Acknowledge Bug Report"
      },
      {
        "command": "reprise.acknowledgeCustom",
        "title": "Reprise: Acknowledge with Custom Trial Count"
      },
      {
        "command": "reprise.runMoreTrials",
        "title": "Reprise: Run More Trials"
      },
      {
        "command": "reprise.chooseTestFile",
        "title": "Reprise: Choose Test File for Report"
      },
      {
        "command": "reprise.runReproTestAgain",
        "title": "Reprise: Run Reproduction Test Again"
      },
      {
        "command": "reprise.acceptDiagnosis",
        "title": "Reprise: Accept Diagnosis"
      },
      {
        "command": "reprise.proposeFixes",
        "title": "Reprise: Propose Fixes"
      },
      {
        "command": "reprise.verifyFix",
        "title": "Reprise: Verify Fix"
      },
      {
        "command": "reprise.markReadyForReview",
        "title": "Reprise: Mark Ready for Review"
      },
      {
        "command": "reprise.addressReviewComments",
        "title": "Reprise: Address Review Comments"
      },
      {
        "command": "reprise.setupCiRuns",
        "title": "Reprise: Set Up CI Runs"
      },
      {
        "command": "reprise.publishRecord",
        "title": "Reprise: Publish Record"
      },
      {
        "command": "reprise.openDashboard",
        "title": "Reprise: Open Dashboard"
      },
      {
        "command": "reprise.selectProvider",
        "title": "Reprise: Select Provider"
      },
      {
        "command": "reprise.showMachineCapabilities",
        "title": "Reprise: Show Machine Capabilities"
      },
      {
        "command": "reprise.openLocalRepository",
        "title": "Reprise: Open Local Repository"
      },
      {
        "command": "reprise.refreshBugReports",
        "title": "Reprise: Refresh Bug Reports",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reprise.refreshBugReports",
          "when": "view == reprise.bugReports",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "reprise.acknowledgeBugReport",
          "when": "view == reprise.bugReports && viewItem =~ /acknowledgeAllowed/",
          "group": "inline"
        },
        {
          "command": "reprise.openDashboard",
          "when": "view == reprise.bugReports",
          "group": "1_open"
        }
      ]
    },
    "configuration": {
      "title": "Reprise",
      "properties": {
        "reprise.provider": {
          "type": "string",
          "default": "stub",
          "enum": [
            "stub",
            "claude",
            "bob",
            "gemini",
            "groq"
          ],
          "description": "AI provider to use for reasoning stages.",
          "scope": "window"
        },
        "reprise.postResultsToGitHub": {
          "type": "boolean",
          "default": false,
          "description": "Automatically post run results as comments on the GitHub issue.",
          "scope": "window"
        },
        "reprise.defaultExecutor": {
          "type": "string",
          "default": "local",
          "enum": [
            "local",
            "ci"
          ],
          "description": "Default executor to use when running tests.",
          "scope": "window"
        },
        "reprise.dashboardUrl": {
          "type": "string",
          "default": "",
          "description": "URL of the Reprise dashboard.",
          "scope": "window"
        },
        "reprise.runnerPort": {
          "type": "number",
          "default": 47410,
          "description": "Port the Reprise Runner is listening on.",
          "scope": "window"
        },
        "reprise.dev.useFakes": {
          "type": "boolean",
          "default": false,
          "description": "Use in-memory fake implementations of all services (for development).",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack --config webpack.config.js",
    "watch": "webpack --config webpack.config.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "test": "node --test out/test/**/*.test.js",
    "pretest": "tsc --outDir out"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.7.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "js-yaml": "^4.1.0"
  }
}
