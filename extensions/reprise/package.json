{
  "name": "reprise",
  "description": "Bug replication and fix pipeline for mobile and desktop apps.",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "test": "node --test out/test/*.test.js out/test/e2e/*.test.js",
    "pretest": "tsc --outDir out"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "js-yaml": "^4.1.0"
  },
  "main": "out/src/index.js",
  "types": "out/src/index.d.ts"
}
